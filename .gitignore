# virtualenv
.venv/
venv/
.venv-datasphere/
.tools/

# extraction cache (content-addressed; safe to delete, will re-fill)
.cache/

# run outputs (keep the results/ dir, ignore generated artifacts)
results/*
!results/.gitkeep

# RAGTruth data (download with download_data.py)
data/*.jsonl
data/ragtruth/
data/subsets/
# Keep local run artifacts under version control so other developers can inspect
# execution traces and the generated HTML viewer.
examples/mock_output/

# synthetic smoke fixtures
tests/fixture_data/

# python
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Local OpenRouter credential for the KGGen micro demo. Never commit it.
.env.micro_qa_demo

# Rendered DataSphere Job submissions are per-run artifacts, not source config.
datasphere/jobs/rendered/
