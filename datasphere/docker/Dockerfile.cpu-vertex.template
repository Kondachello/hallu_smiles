# Rendered in CI from a pinned commit for CPU-only DataSphere Vertex probes.
FROM python:3.11-slim

ARG DEBIAN_FRONTEND=noninteractive
ARG SOURCE_COMMIT=__GIT_COMMIT__
ARG SOURCE_ROOT=https://raw.githubusercontent.com/Kondachello/hallu_smiles
ARG EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git bash coreutils tar gzip gcc \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash --uid 1000 jupyter

RUN python -m venv /opt/hallu/client \
    && /opt/hallu/client/bin/python -m pip install --no-cache-dir --upgrade pip==25.1.1 \
    && mkdir -p /opt/hallu/build /opt/hallu/manifests /opt/hallu/models \
    && curl -fsSL "$SOURCE_ROOT/$SOURCE_COMMIT/datasphere/docker/client.requirements.txt" -o /opt/hallu/build/client.requirements.txt \
    && curl -fsSL "$SOURCE_ROOT/$SOURCE_COMMIT/datasphere/docker/write_cpu_vertex_runtime_manifest.py" -o /opt/hallu/build/write_cpu_vertex_runtime_manifest.py \
    && /opt/hallu/client/bin/python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.6.0+cpu \
    && /opt/hallu/client/bin/python -m pip install --no-cache-dir -r /opt/hallu/build/client.requirements.txt \
    && /opt/hallu/client/bin/python -m pip check \
    && /opt/hallu/client/bin/python -c "import torch; assert torch.__version__ == '2.6.0+cpu'; assert torch.version.cuda is None"

RUN /opt/hallu/client/bin/python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='sentence-transformers/all-MiniLM-L6-v2', revision='$EMBEDDING_REVISION', local_dir='/opt/hallu/models/all-MiniLM-L6-v2', allow_patterns=['config.json','config_sentence_transformers.json','modules.json','sentence_bert_config.json','model.safetensors','tokenizer.json','tokenizer_config.json','special_tokens_map.json','vocab.txt','1_Pooling/*'])" \
    && /opt/hallu/client/bin/python -m pip freeze --all | LC_ALL=C sort > /opt/hallu/manifests/client.freeze.txt \
    && /opt/hallu/client/bin/python /opt/hallu/build/write_cpu_vertex_runtime_manifest.py \
       --source-commit "$SOURCE_COMMIT" \
       --client-freeze /opt/hallu/manifests/client.freeze.txt \
       --client-python /opt/hallu/client/bin/python \
       --embedding-path /opt/hallu/models/all-MiniLM-L6-v2 \
       --embedding-revision "$EMBEDDING_REVISION" \
       --output /opt/hallu/runtime-manifest.json \
    && chmod -R a+rX /opt/hallu

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false \
    SENTENCE_TRANSFORMERS_HOME=/opt/hallu/models \
    PYTHONHASHSEED=42

USER jupyter
WORKDIR /home/jupyter
CMD ["bash"]
