# CPU-only runner for the controlled Llama-3.1 RAGTruth experiment.
FROM python:3.11-slim

ARG DEBIAN_FRONTEND=noninteractive
ARG SOURCE_COMMIT
ARG EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git bash coreutils \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash --uid 1000 hallu

WORKDIR /opt/hallu/source
COPY gcp/client.requirements.txt /opt/hallu/build/client.requirements.txt
COPY . /opt/hallu/source

RUN python -m venv /opt/hallu/client \
    && /opt/hallu/client/bin/python -m pip install --no-cache-dir --upgrade pip==25.1.1 \
    && /opt/hallu/client/bin/python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.6.0+cpu \
    && /opt/hallu/client/bin/python -m pip install --no-cache-dir -r /opt/hallu/build/client.requirements.txt \
    && /opt/hallu/client/bin/python -m pip install --no-cache-dir google-cloud-secret-manager==2.24.0 google-cloud-storage==2.19.0 \
    && /opt/hallu/client/bin/python -m pip check

RUN mkdir -p /opt/hallu/models \
    && /opt/hallu/client/bin/python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='sentence-transformers/all-MiniLM-L6-v2', revision='$EMBEDDING_REVISION', local_dir='/opt/hallu/models/all-MiniLM-L6-v2', allow_patterns=['config.json','config_sentence_transformers.json','modules.json','sentence_bert_config.json','model.safetensors','tokenizer.json','tokenizer_config.json','special_tokens_map.json','vocab.txt','1_Pooling/*'])" \
    && /opt/hallu/client/bin/python /opt/hallu/source/gcp/write_gcp_runtime_manifest.py \
       --source-commit "$SOURCE_COMMIT" \
       --embedding-model-path /opt/hallu/models/all-MiniLM-L6-v2 \
       --output /opt/hallu/runtime-manifest.json \
    && chmod -R a+rX /opt/hallu

ENV PATH=/opt/hallu/client/bin:$PATH \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false \
    PYTHONHASHSEED=42

USER hallu
WORKDIR /opt/hallu/source
ENTRYPOINT ["bash", "scripts/run_gcp_ragtruth_llama31_eval.sh"]
