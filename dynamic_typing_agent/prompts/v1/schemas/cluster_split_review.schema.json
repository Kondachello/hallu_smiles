{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hallugraph:dynamic-typing:cluster-split-review:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cluster_decisions"],
  "properties": {
    "schema_version": {"const": "cluster-split-review-v1"},
    "cluster_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type_id", "decision", "replacement_parent", "partitions", "evidence_span_ids", "requires_nli", "reason"],
        "properties": {
          "type_id": {"type": "string"},
          "decision": {"enum": ["keep", "generalize", "split", "unknown"]},
          "replacement_parent": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["candidate_type_id", "label", "definition"],
            "properties": {
              "candidate_type_id": {"type": "string"},
              "label": {"type": "string"},
              "definition": {"type": "string"}
            }
          },
          "partitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_type_id", "label", "definition", "entity_ids", "evidence_span_ids"],
              "properties": {
                "candidate_type_id": {"type": "string"},
                "label": {"type": "string"},
                "definition": {"type": "string"},
                "entity_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "evidence_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          },
          "evidence_span_ids": {"type": "array", "items": {"type": "string"}},
          "requires_nli": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

