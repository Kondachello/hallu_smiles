xt:span:5","query:span:0"],"graph_role":"context","node_id":"node:f881e2f4a861c39061b5","reason":"No explicit source type relation.","status":"unknown","surface_text":"ООО «Маяк»","type_ids":[]},{"evidence_span_ids":[],"graph_role":"context","node_id":"node:ff140615a32466df33b7","reason":"No explicit source type relation.","status":"unknown","surface_text":"финансовая организация","type_ids":[]}],"context_graph_id":"dt-ru-001-credit-risk-structure:context","evidence_spans":[{"end_char":114,"source_role":"context","span_id":"context:span:0","start_char":0,"text":"В апреле 2024 года АО «Северный Берег» заключило с ООО «Маяк» кредитный договор на развитие логистического центра."},{"end_char":226,"source_role":"context","span_id":"context:span:1","start_char":115,"text":"АО «Северный Берег» является региональным коммерческим банком и входит в группу финансовых организаций «Полюс»."},{"end_char":324,"source_role":"context","span_id":"context:span:2","start_char":227,"text":"По договору банк предоставил ООО «Маяк» кредит в размере 180 миллионов рублей сроком на пять лет."},{"end_char":415,"source_role":"context","span_id":"context:span:3","start_char":325,"text":"ООО «Маяк» выступает заёмщиком и обязано ежеквартально представлять банку отчёт о выручке."},{"end_char":510,"source_role":"context","span_id":"context:span:4","start_char":416,"text":"Исполнение обязательств заёмщика обеспечено залогом складского комплекса «Восточный терминал»."},{"end_char":599,"source_role":"context","span_id":"context:span:5","start_char":511,"text":"Складской комплекс является объектом коммерческой недвижимости и принадлежит ООО «Маяк»."},{"end_char":698,"source_role":"context","span_id":"context:span:6","start_char":600,"text":"Независимый оценщик ООО «Оценка-Профи» определил рыночную стоимость залога в 260 миллионов рублей."},{"end_char":792,"source_role":"context","span_id":"context:span:7","start_char":699,"text":"АО «Гарант» — страховая компания; она застраховала складской комплекс от пожара и затопления."},{"end_char":850,"source_role":"context","span_id":"context:span:8","start_char":793,"text":"В договоре АО «Гарант» не названо поручителем по кредиту."},{"end_char":937,"source_role":"context","span_id":"context:span:9","start_char":851,"text":"Юрист банка Ирина Лебедева проверила комплект документов и согласовала выдачу кредита."},{"end_char":1039,"source_role":"context","span_id":"context:span:10","start_char":938,"text":"Ирина Лебедева является физическим лицом и действует в роли юриста банка только в рамках этой сделки."},{"end_char":1126,"source_role":"context","span_id":"context:span:11","start_char":1040,"text":"После выдачи кредита банк открыл для заёмщика ссудный счёт и направил график платежей."},{"end_char":1245,"source_role":"context","span_id":"context:span:12","start_char":1127,"text":"В контексте нет сведений о том, что АО «Северный Берег» является системно значимым банком или государственным органом."},{"end_char":161,"source_role":"query","span_id":"query:span:0","start_char":0,"text":"Какая организация выдала кредит ООО «Маяк», какие постоянные типы и контекстные роли прямо подтверждаются для участников сделки и какой объект выступает залогом?"}],"frozen":true,"prompt_manifest_sha256":"667fc860db45150c030ba940b3b3e502973ef2d3f5d09dab6d27686a3c774c02","query_graph_id":"dt-ru-001-credit-risk-structure:query","registry_id":"registry:be509022b5fcdda0ecb1","registry_sha256":"be509022b5fcdda0ecb163b3bd3645262a73dae231cdea97e5d2601d9635a3b6","source_id":"src-ru-credit-1","types":[{"aliases":[],"definition":"Source-local type explicitly named as 'коммерческий банк'.","evidence_level":"unknown","evidence_span_ids":[],"label":"коммерческий банк","parent_type_ids":["T-ENTITY"],"status":"preliminary","type_id":"T-01A3A677B3C5"},{"aliases":[],"definition":"Финансовое средство, предоставляемое банком заёмщику.","evidence_level":"source_entailed","evidence_span_ids":["context:span:0","context:span:2","context:span:8","context:span:9","context